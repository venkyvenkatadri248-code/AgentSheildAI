# Environment Configuration Example for AgentShieldAI
APP_ENV=development
APP_NAME=AgentShieldAI

# Database Configuration (PostgreSQL by default, falls back to SQLite if not provided)
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/agentshieldai
# Fallback local SQLite:
# DATABASE_URL=sqlite:///./agentshieldai.db

# Official Google Gemini API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL for CORS (comma-separated list for multiple domains)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost

# Optional: When hosting frontend separately (e.g. Vercel, Netlify, Cloudflare Pages)
# set these in your frontend hosting environment settings:
# VITE_API_BASE_URL=https://your-backend-domain.com/api
# VITE_WS_URL=wss://your-backend-domain.com/ws

# Security & JWT Authentication Secret
AUTH_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Constraints
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.txt,.pdf,.csv,.md,.json
UPLOAD_DIR=./uploads

